# ============================================================
# AI 人物陪伴平台 - 环境变量模板
# 复制为 .env 并填入真实值；切勿提交 .env
# ============================================================
# 生产环境快速生成 SECRET_KEY：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ---------- 应用 ----------
APP_ENV=production
APP_NAME=companion-platform
APP_PORT=8000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
# JWT 访问令牌有效期（分钟）
JWT_ACCESS_EXPIRE_MINUTES=60
# JWT 刷新令牌有效期（天）
JWT_REFRESH_EXPIRE_DAYS=30
# CORS 允许的前端来源（逗号分隔），如：https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ---------- 数据库（PostgreSQL + pgvector） ----------
DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion
DATABASE_SYNC_URL=postgresql://companion:companion@localhost:5432/companion

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 对象存储（S3 兼容） ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=companion-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
# 签名 URL 有效期（秒）
S3_PRESIGN_EXPIRES=3600

# ---------- OAuth（Google / Facebook） ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/callback/facebook

# ---------- LLM 供应商 ----------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ---------- 视觉模型供应商 ----------
IMAGE_PROVIDER=dummy
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=

VIDEO_PROVIDER=dummy
VIDEO_API_KEY=
VIDEO_MODEL=

# ---------- 文本嵌入（记忆向量） ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- 内容安全审核 ----------
SAFETY_PROVIDER=dummy
SAFETY_API_KEY=

# ---------- 支付（Stripe） ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUBSCRIPTION=
STRIPE_PRICE_CREDITS=
# 前端跳转
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# ---------- 限流 ----------
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# 生产环境（docker-compose.prod.yml）额外需要：
# ============================================================
# DB_USER=companion
# DB_PASSWORD=<strong-password>
# DB_NAME=companion
# NEXT_PUBLIC_API_URL=https://your-domain.com/api
# LLM_PROVIDER=openai        # 或 ollama / deepseek / vllm（均兼容 OpenAI API 协议）
# LLM_BASE_URL=https://api.openai.com/v1   # 自托管改为 http://your-gpu:11434/v1
# IMAGE_PROVIDER=replicate   # 或 dummy（先跑通文本对话）
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=companion-assets
# S3_ACCESS_KEY=<r2-access-key>
# S3_SECRET_KEY=<r2-secret-key>
